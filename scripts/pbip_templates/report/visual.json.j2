{#- Ordem de chaves e campos ("active", sortDefinition, drillFilterOtherVisuals
    depois de visualContainerObjects) seguem o que o Power BI Desktop grava, para
    que regenerar o PBIP nao produza diff sobre um projeto salvo pelo Desktop.
    Textbox JA foi reserializado pelo Desktop (2026-08-17): saiu do schema 1.0.0
    para 2.11.0, passou a gravar height antes de width e reordenou textStyle para
    fontWeight/fontSize/color com o hex em minusculas. -#}
{%- if visual.visual_type == "textbox" %}
{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.11.0/schema.json",
  "name": "{{ visual.name }}",
  "position": {
    "x": {{ visual.position.x }},
    "y": {{ visual.position.y }},
    "z": {{ visual.position.z | default(0) }},
    "height": {{ visual.position.height }},
    "width": {{ visual.position.width }},
    "tabOrder": {{ visual.tab_order | default(0) }}
  },
  "visual": {
    "visualType": "textbox",
    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    {#- tojson escapa aspas do texto: as notas sao montadas a
                        partir dos CSVs curados, entao o conteudo varia. -#}
                    "value": {{ visual.text | tojson }},
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "{{ visual.font_size | default('20pt') }}",
                      "color": "#1f3864"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}
{%- else %}
{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.11.0/schema.json",
  "name": "{{ visual.name }}",
  "position": {
    "x": {{ visual.position.x }},
    "y": {{ visual.position.y }},
    "z": {{ visual.position.z | default(0) }},
    "height": {{ visual.position.height }},
    "width": {{ visual.position.width }},
    "tabOrder": {{ visual.tab_order | default(0) }}
  },
  "visual": {
    "visualType": "{{ visual.visual_type }}",
    "query": {
      "queryState": {
{%- for role_name, projections in visual.projections.items() %}
{#- Papeis categoricos (e o Values do slicer) carregam a flag "active": o
    primeiro campo do papel e o ativo, os demais sao niveis de drill. -#}
{%- set marca_ativo = role_name in ("Category", "Rows", "Columns")
                      or (role_name == "Values" and visual.visual_type == "slicer") %}
        "{{ role_name }}": {
          "projections": [
{%- for proj in projections %}
            {
              "field": {
{%- if proj.kind == "measure" %}
                "Measure": {
                  "Expression": { "SourceRef": { "Entity": "{{ proj.entity }}" } },
                  "Property": "{{ proj.property }}"
                }
{%- else %}
                "Column": {
                  "Expression": { "SourceRef": { "Entity": "{{ proj.entity }}" } },
                  "Property": "{{ proj.property }}"
                }
{%- endif %}
              },
              "queryRef": "{{ proj.query_ref }}",
              "nativeQueryRef": "{{ proj.native_query_ref }}"
{%- if marca_ativo %},
              "active": {{ "true" if loop.first else "false" }}
{%- endif %}
            }{% if not loop.last %},{% endif %}
{%- endfor %}
          ]
        }{% if not loop.last %},{% endif %}
{%- endfor %}
      },
      "sortDefinition": {{ visual.sort_json | default('{"isDefaultSort": true}') }}
    },
{%- if visual.objects_json %}
    "objects": {{ visual.objects_json }},
{%- endif %}
{%- if visual.title %}
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": { "expr": { "Literal": { "Value": "true" } } },
            "text": { "expr": { "Literal": { "Value": "'{{ visual.title }}'" } } }
          }
        }
      ]
    },
{%- endif %}
    "drillFilterOtherVisuals": true
  }
{%- if visual.filters %},
  "filterConfig": {
    "filters": {{ visual.filters_json }}
  }
{%- endif %}
}
{%- endif %}
