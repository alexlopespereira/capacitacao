/// Tabela fato unica gerada por scripts/gerar_base_dashboard.py
/// 385k linhas — schema flat (sem dimensoes separadas).
table dashboard_base
	lineageTag: {{ lineage.table_dashboard_base }}

	/// O relatorio aplica um filtro de nivel de relatorio categoria IN {"IA","Dados"},
	/// entao [Matriculas]/[Pessoas Unicas] "totais" ja excluem Gestao/Outros: sao o
	/// universo do painel de capacitacao em IA e Dados.
	measure 'Matriculas' = COUNTROWS(dashboard_base)
		formatString: #,0
		lineageTag: {{ lineage.measure_matriculas }}

	measure 'Matriculas IA' = CALCULATE([Matriculas], dashboard_base[categoria] = "IA")
		formatString: #,0
		lineageTag: {{ lineage.measure_matriculas_ia }}

	measure 'Matriculas Dados' = CALCULATE([Matriculas], dashboard_base[categoria] = "Dados")
		formatString: #,0
		lineageTag: {{ lineage.measure_matriculas_dados }}

	measure 'Pessoas Unicas' = DISTINCTCOUNT(dashboard_base[codigo_pessoa])
		formatString: #,0
		lineageTag: {{ lineage.measure_pessoas_unicas }}

	measure 'Pessoas Unicas IA' = CALCULATE([Pessoas Unicas], dashboard_base[categoria] = "IA")
		formatString: #,0
		lineageTag: {{ lineage.measure_pessoas_unicas_ia }}

	measure 'Pessoas Unicas Dados' = CALCULATE([Pessoas Unicas], dashboard_base[categoria] = "Dados")
		formatString: #,0
		lineageTag: {{ lineage.measure_pessoas_unicas_dados }}

	measure '% Matriculas IA' = DIVIDE([Matriculas IA], [Matriculas])
		formatString: 0.0%
		lineageTag: {{ lineage.measure_pct_matriculas_ia }}

	measure '% Matriculas Dados' = DIVIDE([Matriculas Dados], [Matriculas])
		formatString: 0.0%
		lineageTag: {{ lineage.measure_pct_matriculas_dados }}

	column ano_mes
		dataType: string
		sourceColumn: ano_mes
		sortByColumn: ano_mes_sort
		summarizeBy: none
		lineageTag: {{ lineage.column_ano_mes }}

	column ano
		dataType: int64
		sourceColumn: ano
		formatString: 0
		summarizeBy: none
		lineageTag: {{ lineage.column_ano }}

	column mes
		dataType: int64
		sourceColumn: mes
		formatString: 0
		summarizeBy: none
		lineageTag: {{ lineage.column_mes }}

	column id_curso
		dataType: int64
		sourceColumn: id_curso
		formatString: 0
		summarizeBy: none
		lineageTag: {{ lineage.column_id_curso }}

	column nome_curso
		dataType: string
		sourceColumn: nome_curso
		summarizeBy: none
		lineageTag: {{ lineage.column_nome_curso }}

	/// Categoria do curso: IA / Dados / Gestão / Outros. O painel conta IA+Dados;
	/// Gestão e Outros ficam na base (auditaveis) mas fora dos indicadores.
	column categoria
		dataType: string
		sourceColumn: categoria
		summarizeBy: none
		lineageTag: {{ lineage.column_categoria }}

	column esfera
		dataType: string
		sourceColumn: esfera
		summarizeBy: none
		lineageTag: {{ lineage.column_esfera }}

	column setor
		dataType: string
		sourceColumn: setor
		summarizeBy: none
		lineageTag: {{ lineage.column_setor }}

	column poder
		dataType: string
		sourceColumn: poder
		summarizeBy: none
		lineageTag: {{ lineage.column_poder }}

	column codigo_pessoa
		dataType: string
		sourceColumn: codigo_pessoa
		isHidden
		summarizeBy: none
		lineageTag: {{ lineage.column_codigo_pessoa }}

	/// Coluna calculada para ordenacao cronologica do eixo de linha temporal.
	column ano_mes_sort = ([ano] * 100) + [mes]
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		lineageTag: {{ lineage.column_ano_mes_sort }}

	partition dashboard_base = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(CsvPath), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Promoted, {
						{"ano_mes", type text},
						{"ano", Int64.Type},
						{"mes", Int64.Type},
						{"id_curso", Int64.Type},
						{"nome_curso", type text},
						{"categoria", type text},
						{"esfera", type text},
						{"setor", type text},
						{"poder", type text},
						{"codigo_pessoa", type text}
					})
				in
					Typed

	annotation PBI_ResultType = Table
