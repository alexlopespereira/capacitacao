/// Tabela fato unica gerada por scripts/gerar_base_dashboard.py
/// ~420k linhas — schema flat (sem dimensoes separadas).
table dashboard_base
	lineageTag: {{ lineage.table_dashboard_base }}

	/// O relatorio aplica filtros de nivel de relatorio categoria IN {"IA","Dados"}
	/// e esfera = "Federal" (o foco declarado do painel; editavel no painel
	/// Filtros), entao [Conclusoes]/[Pessoas Unicas] "totais" ja excluem
	/// Gestao/Outros e, por padrao, as demais esferas. A tabela carrega todas as
	/// esferas — nada e truncado na carga.
	measure Conclusoes = COUNTROWS(dashboard_base)
		formatString: #,0
		lineageTag: {{ lineage.measure_conclusoes }}

	measure 'Conclusoes IA' = CALCULATE([Conclusoes], dashboard_base[categoria] = "IA")
		formatString: #,0
		lineageTag: {{ lineage.measure_conclusoes_ia }}

	measure 'Conclusoes Dados' = CALCULATE([Conclusoes], dashboard_base[categoria] = "Dados")
		formatString: #,0
		lineageTag: {{ lineage.measure_conclusoes_dados }}

	measure 'Pessoas Unicas' = DISTINCTCOUNT(dashboard_base[codigo_pessoa])
		formatString: #,0
		lineageTag: {{ lineage.measure_pessoas_unicas }}

	measure 'Pessoas Unicas IA' = CALCULATE([Pessoas Unicas], dashboard_base[categoria] = "IA")
		formatString: #,0
		lineageTag: {{ lineage.measure_pessoas_unicas_ia }}

	measure 'Pessoas Unicas Dados' = CALCULATE([Pessoas Unicas], dashboard_base[categoria] = "Dados")
		formatString: #,0
		lineageTag: {{ lineage.measure_pessoas_unicas_dados }}

	measure '% Conclusoes IA' = DIVIDE([Conclusoes IA], [Conclusoes])
		formatString: 0.0%
		lineageTag: {{ lineage.measure_pct_conclusoes_ia }}

	measure '% Conclusoes Dados' = DIVIDE([Conclusoes Dados], [Conclusoes])
		formatString: 0.0%
		lineageTag: {{ lineage.measure_pct_conclusoes_dados }}

	column ano_mes
		dataType: string
		lineageTag: {{ lineage.column_ano_mes }}
		summarizeBy: none
		sourceColumn: ano_mes
		sortByColumn: ano_mes_sort

	column ano
		dataType: int64
		formatString: 0
		lineageTag: {{ lineage.column_ano }}
		summarizeBy: none
		sourceColumn: ano

	column mes
		dataType: int64
		formatString: 0
		lineageTag: {{ lineage.column_mes }}
		summarizeBy: none
		sourceColumn: mes

	column id_curso
		dataType: int64
		formatString: 0
		lineageTag: {{ lineage.column_id_curso }}
		summarizeBy: none
		sourceColumn: id_curso

	column nome_curso
		dataType: string
		lineageTag: {{ lineage.column_nome_curso }}
		summarizeBy: none
		sourceColumn: nome_curso

	/// Categoria do curso: IA / Dados / Gestão / Outros. O painel conta IA+Dados;
	/// Gestão e Outros ficam na base (auditaveis) mas fora dos indicadores.
	column categoria
		dataType: string
		lineageTag: {{ lineage.column_categoria }}
		summarizeBy: none
		sourceColumn: categoria

	column esfera
		dataType: string
		lineageTag: {{ lineage.column_esfera }}
		summarizeBy: none
		sourceColumn: esfera

	column setor
		dataType: string
		lineageTag: {{ lineage.column_setor }}
		summarizeBy: none
		sourceColumn: setor

	column poder
		dataType: string
		lineageTag: {{ lineage.column_poder }}
		summarizeBy: none
		sourceColumn: poder

	column codigo_pessoa
		dataType: string
		isHidden
		lineageTag: {{ lineage.column_codigo_pessoa }}
		summarizeBy: none
		sourceColumn: codigo_pessoa

	/// Coluna calculada para ordenacao cronologica do eixo de linha temporal.
	column ano_mes_sort = ([ano] * 100) + [mes]
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: {{ lineage.column_ano_mes_sort }}
		summarizeBy: none

	partition dashboard_base = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(CsvPath), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Promoted, {
						{"ano_mes", type text},
						{"ano", Int64.Type},
						{"mes", Int64.Type},
						{"id_curso", Int64.Type},
						{"nome_curso", type text},
						{"categoria", type text},
						{"esfera", type text},
						{"setor", type text},
						{"poder", type text},
						{"codigo_pessoa", type text}
					})
				in
					Typed

	annotation PBI_ResultType = Table
