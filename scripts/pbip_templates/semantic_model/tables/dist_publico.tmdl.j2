/// Distribuicao de cursos-por-pessoa por publico-alvo (pre-computada por
/// scripts/gerar_distribuicao_publico.py). Grao: (publico, k) onde k = nº de
/// cursos distintos do publico concluidos; qtd_pessoas = pessoas com aquele k.
/// Tabela autonoma (sem relacionamentos): retrato estatico sobre todo o
/// historico — NAO responde aos slicers de esfera/ano.
/// O recorte padrao do painel (categorias IA/Dados + esfera Federal) ja vem
/// aplicado do gerador: o grao pre-agregado nao tem chave de curso nem de
/// esfera, entao o filtro de relatorio nao teria por onde entrar sem mudar o
/// k de cada pessoa.
/// As medidas retornam BLANK fora do contexto de UM publico: somar as fatias
/// contaria a mesma pessoa em cada publico que contem um curso que ela
/// concluiu (um curso pertence a varios publicos), e o painel nunca exibe
/// numero maior do que a realidade.
table dist_publico
	lineageTag: {{ lineage.table_dist_publico }}

	measure 'Qtd Pessoas' = IF(HASONEVALUE(dist_publico[publico_alvo]), SUM(dist_publico[qtd_pessoas]))
		formatString: #,0
		lineageTag: {{ lineage.measure_dist_qtd_pessoas }}

	measure 'Pessoas com Todos os Cursos' = IF(HASONEVALUE(dist_publico[publico_alvo]), SUMX(FILTER(dist_publico, dist_publico[qtd_cursos] = dist_publico[n_cursos_publico]), dist_publico[qtd_pessoas]))
		formatString: #,0
		lineageTag: {{ lineage.measure_dist_pessoas_todos }}

	measure '% Concluiu Tudo' = DIVIDE([Pessoas com Todos os Cursos], [Qtd Pessoas])
		formatString: 0.00%
		lineageTag: {{ lineage.measure_dist_pct_todos }}

	measure 'Media Cursos por Pessoa' = DIVIDE(SUMX(dist_publico, dist_publico[qtd_cursos] * dist_publico[qtd_pessoas]), [Qtd Pessoas])
		formatString: 0.00
		lineageTag: {{ lineage.measure_dist_media }}

	measure 'Qtd Cursos no Publico' = IF(HASONEVALUE(dist_publico[publico_alvo]), MAX(dist_publico[n_cursos_publico]))
		formatString: 0
		lineageTag: {{ lineage.measure_dist_cursos_no_publico }}

	column publico_alvo
		dataType: string
		lineageTag: {{ lineage.column_dist_publico_alvo }}
		summarizeBy: none
		sourceColumn: publico_alvo

	column qtd_cursos
		dataType: int64
		formatString: 0
		lineageTag: {{ lineage.column_dist_qtd_cursos }}
		summarizeBy: none
		sourceColumn: qtd_cursos

	column qtd_pessoas
		dataType: int64
		formatString: 0
		lineageTag: {{ lineage.column_dist_qtd_pessoas }}
		summarizeBy: none
		sourceColumn: qtd_pessoas

	column n_cursos_publico
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: {{ lineage.column_dist_n_cursos }}
		summarizeBy: none
		sourceColumn: n_cursos_publico

	partition dist_publico = m
		mode: import
		source =
				let
					Folder = Text.BeforeDelimiter(CsvPath, "/", {0, RelativePosition.FromEnd}),
					DistPath = Folder & "/dashboard_dist_publico.csv",
					Source = Csv.Document(File.Contents(DistPath), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Promoted, {
						{"publico_alvo", type text},
						{"qtd_cursos", Int64.Type},
						{"qtd_pessoas", Int64.Type},
						{"n_cursos_publico", Int64.Type}
					})
				in
					Typed

	annotation PBI_ResultType = Table
